# ================================================================
# RAG_mine 环境配置
# 注意：路径都是相对「项目根目录」的，请在 D:\project\llm\RAG_mine 下启动服务
# ================================================================

# ---------------------------------------------------------------- LLM（智谱 GLM，OpenAI 兼容协议）
LLM_MODEL=glm-4.5-air
LLM_API_KEY=请填写你的智谱APIKey
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------- Redis / LLM 响应缓存
# 启动 Redis 示例：docker run -d --name rag-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0
LLM_CACHE_ENABLED=true
# 0 表示永不过期；生产环境建议设置合理 TTL，避免陈旧答案长期保留
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_PREFIX=rag:llm-cache:v1
# Redis 不可用时快速旁路，LLM 请求仍会正常执行
REDIS_SOCKET_TIMEOUT_SECONDS=1.5
# 连接失败后暂时停止访问 Redis，防止一次请求中的多个 LLM 节点反复超时
LLM_CACHE_FAILURE_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------- Prometheus 指标
# 设为 false 可完全关闭指标中间件和 /metrics 端点
METRICS_ENABLED=true
METRICS_PATH=/metrics

# RAGAs 等第三方库会直接读 OPENAI_API_KEY / OPENAI_BASE_URL，这里指向同一个智谱端点
OPENAI_API_KEY=请填写你的智谱APIKey（同 LLM_API_KEY）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 阿里云百炼（备用模型，当前代码未使用）
ALI_BASE_URL=https://ws-1ofh66f2687cvsqr.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ALI_API_KEY=请填写（当前代码未使用，可留空）

GEMINI_API_KEY=请填写（当前代码未使用，可留空）

# ---------------------------------------------------------------- Embedding（本地，不走 API）
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- 向量库（Milvus）
# 【重要】变量名必须是 RAG_MILVUS_URI，不能写成 MILVUS_URI！
# pymilvus 3.x 会在 import 阶段读取环境变量 MILVUS_URI 并强制按 http[s]:// 解析，
# 值若是本地文件路径会让 import pymilvus 直接抛 ConnectionConfigException。
RAG_MILVUS_URI=./vector_db/milvus_rag.db
# 远程 Milvus / Zilliz Cloud 鉴权用，本地文件模式留空
MILVUS_TOKEN=
# 只有换了 Embedding 模型、向量维度变了才临时改成 true；改完立刻改回 false，
# 否则每次重启都会清空知识库
MILVUS_DROP_OLD=false

VECTOR_DB_PATH=./vector_db
INDEX_NAME=rag_index
BM25_CORPUS_FILE=bm25_corpus.jsonl

# ---------------------------------------------------------------- 检索超参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# ---------------------------------------------------------------- 混合检索 Hybrid Search
HYBRID_ENABLED=true
# 稠密(向量)/稀疏(BM25) 在 RRF 融合时的权重。
# 专有名词、型号、编号多的知识库 -> 调高 SPARSE_WEIGHT
# 口语化、语义化提问多 -> 调高 DENSE_WEIGHT
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
DENSE_TOP_K=20
SPARSE_TOP_K=20
# 融合后的候选数，也就是送给 Reranker 的条数
FUSION_TOP_K=20

# ---------------------------------------------------------------- 查询变换
# none / multi_query(RAG-Fusion) / hyde
QUERY_TRANSFORM=multi_query
NUM_QUERIES=3

# ---------------------------------------------------------------- 精排 Reranker
RERANK_ENABLED=true
RERANK_PROVIDER=cohere
COHERE_API_KEY=请填写你的CohereAPIKey  # https://dashboard.cohere.com/api-keys
COHERE_RERANK_MODEL=rerank-v3.5
# 精排后最终喂给 LLM 的文档块数
RERANK_TOP_N=5

# ---------------------------------------------------------------- Agentic RAG
# 最大「检索-评分-改写」循环轮数（联网可用时实际改写次数见 WEB_FALLBACK_AFTER_RETRIES）
MAX_RETRIES=2
# LangGraph 单次调用最大步数；代码会自动取它与按配置估算值中的较大者
RECURSION_LIMIT=25

# ---------------------------------------------------------------- 联网搜索（Tavily，状态图里的 web_search 节点）
# 免费申请：https://tavily.com 。不填则只用本地知识库
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
# llm：入口用一次 LLM 判断是否需要实时信息，需要就直接联网
# off：总是先查本地，本地没有相关文档再联网（每次少一次 LLM 调用）
WEB_ROUTING=llm
# 本地检索失败后先改写重检索几次再联网（默认 0：直接联网，更快）
WEB_FALLBACK_AFTER_RETRIES=0
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_DEPTH=basic
WEB_SNIPPET_CHARS=800
WEB_SEARCH_TIMEOUT=30
WEB_SEARCH_MAX_ATTEMPTS=2

# ---------------------------------------------------------------- 上下文工程（每次喂给 LLM 的内容预算）
# 注入提示词的最近对话轮数（更早的轮次以滚动摘要形式出现）
HISTORY_TURNS=3
# 对话背景块（摘要 + 最近几轮）的字符预算
MEMORY_CONTEXT_CHARS=1500
# 对话背景里每条历史回答的截断长度
MEMORY_ANSWER_CHARS=300
# 生成答案时检索资料（本地/网页片段）的总字符预算
CONTEXT_MAX_CHARS=6000

# ---------------------------------------------------------------- 会话记忆持久化
# sqlite（默认，零部署）/ redis（多实例共享，复用 REDIS_URL）/ memory（重启即丢）/ off
MEMORY_BACKEND=sqlite
MEMORY_SQLITE_PATH=./vector_db/chat_memory.sqlite3
MEMORY_REDIS_PREFIX=rag:memory:v1
# 会话多久无新消息即过期（秒），0 = 永不过期；默认 7 天
MEMORY_TTL_SECONDS=604800
# 原文超过 WINDOW 轮时，把较早轮次压缩进摘要，只保留最近 KEEP 轮
MEMORY_WINDOW_TURNS=8
MEMORY_KEEP_TURNS=4
MEMORY_SUMMARY_MAX_CHARS=600
MEMORY_STORE_ANSWER_CHARS=2000

# ---------------------------------------------------------------- CLI（python -m research_agent.agent）
# 固定的默认会话 ID：重启 CLI 自动接上上次对话
AGENT_SESSION_ID=research-default
AGENT_WARMUP_ON_START=true

# ---------------------------------------------------------------- 数据目录
DATA_DIR=./data

# ---------------------------------------------------------------- 可选的文档解析服务
UNSTRUCTURED_API_URL=https://platform-api.transform.unstructured.io/api/v1
UNSTRUCTURED_API_KEY=请填写（当前代码未使用，可留空）

# ---------------------------------------------------------------- LangSmith 追踪（可选）
# 保持你原来的设置（开启）。不想追踪就改成 false，
# 能省下每条链路的额外网络开销，调试期再打开。
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=请填写（不用LangSmith可留空）
LANGSMITH_PROJECT=MyFirstProject
